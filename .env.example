# Server Port
PORT=3000

# Required: Google Gemini API Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Required: TinyFish Web Research & Automation API Key (https://agent.tinyfish.ai/api-keys)
TINYFISH_API_KEY=

# Optional: OpenWeatherMap API Key (uses Open-Meteo keyless live Weather & AQI if omitted)
WEATHER_API_KEY=

# Optional: PostgreSQL / Supabase connection URL (uses persistent JSON store if omitted)
DATABASE_URL=

# Optional: Secret token to protect /api/cron/monitor in production
CRON_SECRET=

# Required by OpenStreetMap Nominatim usage policy
NOMINATIM_USER_AGENT=SetuAI/4.0 (contact@example.com)
